{
  "name": "avito-flow-demo",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "backend:dev": "node --env-file=.env.backend --import tsx --watch server/index.ts",
    "backend:build": "tsc -p tsconfig.backend.json",
    "backend:start": "node dist/backend/server/index.js",
    "backend:migrate": "node --env-file=.env.backend --import tsx server/scripts/migrate.ts",
    "backend:create-admin": "node --env-file=.env.backend --import tsx server/scripts/create-admin.ts",
    "test": "tsx --test tests/crm.test.ts tests/crm-repository.test.ts tests/avito-handler.test.ts tests/avito-repository.test.ts tests/avito-webhook.test.ts tests/avito-feed.test.ts tests/avito-messenger-sql.test.ts",
    "test:e2e": "playwright test",
    "avito:bundle": "node scripts/build-avito-function.mjs"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.4",
    "hono": "^4.13.13",
    "lucide-react": "^0.468.0",
    "next": "^16.1.0",
    "pg": "^8.23.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@playwright/test": "^1.58.0",
    "@supabase/supabase-js": "^2.117.1",
    "@tailwindcss/postcss": "^4.1.0",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "tailwindcss": "^4.1.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
