FROM node:22-alpine AS build
WORKDIR /app
COPY docker/image-worker/package.json docker/image-worker/package-lock.json ./
RUN npm ci
COPY server/image-worker.ts server/image-worker-app.ts server/image-provider.ts ./server/
RUN ./node_modules/.bin/tsc --target ES2022 --module NodeNext --moduleResolution NodeNext --strict --skipLibCheck --outDir dist server/image-worker.ts

FROM node:22-alpine AS dependencies
WORKDIR /app
COPY docker/image-worker/package.json docker/image-worker/package-lock.json ./
RUN npm ci --omit=dev && npm cache clean --force

FROM node:22-alpine
ENV NODE_ENV=production
WORKDIR /app
COPY --from=dependencies --chown=node:node /app/node_modules ./node_modules
COPY --from=build --chown=node:node /app/dist ./dist
USER node
EXPOSE 3010
CMD ["node", "dist/image-worker.js"]
