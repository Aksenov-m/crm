# Only server-side Supabase Edge Function secrets. Do not put these in NEXT_PUBLIC_*.
AVITO_CLIENT_ID=replace_with_your_client_id
AVITO_CLIENT_SECRET=replace_with_your_client_secret
# Supabase Authentication -> Users -> your user's UUID, NOT your Avito account ID.
AVITO_CRM_OWNER_ID=00000000-0000-0000-0000-000000000000
AVITO_ALLOWED_ORIGINS=https://proaksenov.ru,http://127.0.0.1:3000
