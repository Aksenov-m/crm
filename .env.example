# Публичные параметры подключения CRM к Supabase; нужны во время сборки сайта.
# Скопируйте в .env.local и вставьте URL и PUBLISHABLE key из Connect в Supabase.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
# Только для текущего статического деплоя Timeweb (значение уже задано в его панели):
# NEXT_OUTPUT=export

# Пароль БД, secret/service_role и ключи Авито сюда не добавлять.
