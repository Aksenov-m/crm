# Copy to .env.backend and replace every placeholder before starting Docker.
APP_DB_USER=prolot_app
APP_DB_PASSWORD=replace_with_output_of_openssl_rand_hex_32
APP_DB_NAME=prolot
PORT=3001
PUBLIC_API_URL=https://api.proaksenov.ru
APP_ORIGINS=https://proaksenov.ru,http://127.0.0.1:3000
AVITO_ALLOWED_ORIGINS=https://proaksenov.ru,http://127.0.0.1:3000
COOKIE_SECURE=true
FILE_STORAGE_DIR=/app/data/uploads
AVITO_CALLBACK_URL=https://proaksenov.ru/api/avito/callback
AVITO_WEBHOOK_SECRET=replace_with_64_hex_characters
AVITO_FEED_SECRET=replace_with_another_64_hex_characters
# Generate once with: openssl rand -hex 32. Keep the same value across deployments and backups.
AVITO_CREDENTIALS_ENCRYPTION_KEY=replace_with_64_hex_characters
# New Avito app keys are added in the Авито section of the CRM.
